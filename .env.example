# Copy to .env and fill in. Never commit .env.

# API (FastAPI)
CARDWISE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
CARDWISE_SUPABASE_URL=http://127.0.0.1:54321
CARDWISE_WEB_ORIGIN=http://localhost:3000
# Comma-separated emails allowed to use the app (GitHub sign-in)
CARDWISE_ALLOWED_EMAILS=
# Model providers (free tiers). Leave empty to use the fake model.
CARDWISE_GEMINI_API_KEY=
CARDWISE_OPENROUTER_API_KEY=

# Web (Next.js). Only NEXT_PUBLIC_ values reach the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
