# Copy to .env and fill in. Never commit .env.

# API (FastAPI)
CARDWISE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
CARDWISE_SUPABASE_URL=http://127.0.0.1:54321
# Comma-separated browser origins allowed by CORS; optional regex for preview URLs, which must
# cover branch (cardwise-web-git-...) and deployment (cardwise-<hash>-...) URLs, e.g.
# ^https://cardwise-(web-)?[a-z0-9-]+-<vercel-scope>\.vercel\.app$
CARDWISE_WEB_ORIGIN=http://localhost:3000
CARDWISE_WEB_ORIGIN_REGEX=
# local | development | preview | production. On Vercel, VERCEL_ENV sets it.
CARDWISE_ENVIRONMENT=local
CARDWISE_LOG_LEVEL=INFO
# Model providers (free tiers). Chain order: api/llm.toml; models without a key are left out.
# With no key at all, sending a message answers 501.
CARDWISE_GEMINI_API_KEY=
CARDWISE_OPENROUTER_API_KEY=
# Model chain file; defaults to api/llm.toml (or ./llm.toml in the working directory).
CARDWISE_LLM_CONFIG=

# Ingest (python -m cardwise_ingest run). Uses CARDWISE_DATABASE_URL above.
# Raw-file archive to Supabase Storage over S3; leave empty to skip archiving.
CARDWISE_STORAGE_S3_ENDPOINT=
CARDWISE_STORAGE_S3_REGION=
CARDWISE_STORAGE_S3_ACCESS_KEY_ID=
CARDWISE_STORAGE_S3_SECRET_ACCESS_KEY=

# Web (Next.js). Only NEXT_PUBLIC_ values reach the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Optional canonical web URL that sign-in callbacks return to. Unset: the Vercel branch URL on
# Previews, otherwise the page's own origin. It must be in the Supabase Redirect URLs.
NEXT_PUBLIC_SITE_URL=
# free | paid. "free" shows the notice that answers come from free model tiers.
NEXT_PUBLIC_LLM_TIER=free
